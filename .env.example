# Geoapify API Key
# Sign up at https://myprojects.geoapify.com to generate a project key
# NOTE: VITE_ keys are accessible to client-side code in browser bundles.
# Always configure API Key Restrictions (Allowed HTTP Referrers/Domains) in your Geoapify project settings.
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
