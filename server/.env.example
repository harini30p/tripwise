# TripWise Backend Environment Variables

# Port on which the Express server listens (default: 5000)
PORT=5000

# Client origin(s) permitted by CORS (comma-separated if multiple, e.g., https://tripwise.example.com)
# In development (NODE_ENV !== 'production'), http://localhost:5173 and http://localhost:5174 are automatically permitted.
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (e.g., from Neon Console)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/tripwise?sslmode=require
